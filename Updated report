const loadLoggedInUserResources = async () => {
  try {
    // Get logged-in user from localStorage token
    const token = localStorage.getItem("custom-auth-token");

    if (!token) {
      console.error("No authentication token found");
      return;
    }

    const loggedInUser = JSON.parse(token);

    console.log("Logged-in token user:", loggedInUser);

    const email =
      loggedInUser.email ||
      loggedInUser.email_id;

    if (!email) {
      console.error("Email not found in authentication token");
      return;
    }

    // Get users
    const usersResponse = await fetch(
      "http://localhost:3000/api/users"
    );

    if (!usersResponse.ok) {
      throw new Error("Failed to fetch users");
    }

    const usersResult = await usersResponse.json();

    const users = usersResult.data || usersResult;

    // Find currently logged-in user
    const currentUser = users.find(
      (user: any) =>
        user.email_id?.toLowerCase() === email.toLowerCase()
    );

    if (!currentUser) {
      console.error("Logged-in user not found in /api/users");
      return;
    }

    console.log("Current user:", currentUser);

    const currentUserId = Number(currentUser.rl_user_id);

    setLoggedInUserId(currentUserId);

    // Get resources
    const resourcesResponse = await fetch(
      "http://localhost:3000/api/resources"
    );

    if (!resourcesResponse.ok) {
      throw new Error("Failed to fetch resources");
    }

    const resourcesResult = await resourcesResponse.json();

    const resources = resourcesResult.data || [];

    console.log("All resources:", resources);

    // IMPORTANT:
    // Only resources assigned to logged-in user
    const myResources = resources.filter(
      (item: any) =>
        Number(item.rl_user_id) === currentUserId
    );

    console.log("Logged-in user's resources:", myResources);

    // Store only user's resources
    setApplications(myResources);

    setFilteredApplications(myResources);

    // -----------------------------
    // UNIQUE TOWERS
    // -----------------------------

    const uniqueTowers = Array.from(
      new Map(
        myResources.map((item: any) => [
          item.tower_id,
          {
            tower_id: item.tower_id,
            tower_name: item.tower_name,
          },
        ])
      ).values()
    );

    console.log("User towers:", uniqueTowers);

    setUserTowers(uniqueTowers);

    // -----------------------------
    // AUTO SELECT TOWER
    // -----------------------------

    if (uniqueTowers.length === 1) {
      setTowerId(String(uniqueTowers[0].tower_id));
    }

  } catch (error) {
    console.error(
      "Error loading logged-in user's resources:",
      error
    );
  }
};


